# Copy to .env for local development. Do not commit .env.

# Transport: 'stdio' (default, for local MCP clients) or 'streamable-http'
# MCP_TRANSPORT=stdio

# HTTP settings (only used when transport is streamable-http)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Override the data directory (default: ./data next to server.py)
# DPU_DATA_DIR=/path/to/your/data
